# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Anthropic Claude API
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Power BI Configuration
# Register an app in Azure AD: https://portal.azure.com/
# Grant Power BI API permissions to your app
POWERBI_CLIENT_ID=your-azure-app-client-id
POWERBI_CLIENT_SECRET=your-azure-app-client-secret
POWERBI_TENANT_ID=your-azure-tenant-id

# Optional: Default workspace ID
POWERBI_WORKSPACE_ID=your-default-workspace-id
